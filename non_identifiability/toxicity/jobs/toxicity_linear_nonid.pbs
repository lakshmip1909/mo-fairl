#!/bin/bash
#PBS -N tox_nonid
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -q v1_gpu72
#PBS -j oe
#PBS -o logs/toxicity_linear_nonid.log

cd "$PBS_O_WORKDIR"

source ~/.bashrc
conda activate irlf

mkdir -p logs data results plots models

echo "========================================"
echo "Toxicity reward non-identifiability pipeline"
echo "Job ID: $PBS_JOBID"
echo "Start: $(date)"
echo "Directory: $(pwd)"
echo "========================================"

python scripts/00_build_jigsaw_pairs.py
python scripts/02_extract_response_features.py
python scripts/03_train_eval_toxicity_rewards.py
python scripts/04_analyse_toxicity_groups.py

echo "========================================"
echo "Done: $(date)"
echo "========================================"
